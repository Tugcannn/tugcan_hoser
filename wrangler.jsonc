{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tugcanhoser",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "tugcanhoser.com/*", "zone_name": "tugcanhoser.com" },
    { "pattern": "www.tugcanhoser.com/*", "zone_name": "tugcanhoser.com" }
  ],
  "assets": {
    "directory": "public"
  }
}
